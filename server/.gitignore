# =========================================================================
# IPL Management System - Production Grade .gitignore
# =========================================================================

# 1. Dependencies (Kabhi bhi dependencies push nahi karte, package.json handle karega)
node_modules/
jspm_packages/
web_modules/

# 2. Environment Secrets (Most Important! Inhe push kiya toh keys leak ho jayengi)
.env
.env.local
.env.production
.env.development
.env.test
*.env

# 3. Logs (Debugging files jo server run karte waqt generate hoti hain)
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 4. Testing & Coverage (Jest framework ke test report folders)
coverage/
.nyc_output/

# 5. IDEs and Editors Configuration (Aapke tools ki personal settings)
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# 6. Operating System Files (Mac aur Windows ki background files)
.DS_Store
Thumbs.db

# 7. Build Outputs (Agar React client ko build karte hain ya TypeScript use karte hain)
dist/
build/
.next/
out/
